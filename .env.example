# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE POSTGRESQL (SOLO LOCAL / SEGURO)
# ==============================================================================
# Copia este archivo a .env y define contraseñas seguras y aleatorias.
# NUNCA subas el archivo .env a tu repositorio Git.
# ==============================================================================

# Nombre del proyecto para Docker Compose
COMPOSE_PROJECT_NAME=breinerdiaz-db

# Credenciales de PostgreSQL
POSTGRES_USER=breiner_admin
# Genera una contraseña segura (mínimo 24 caracteres alfanuméricos con símbolos)
POSTGRES_PASSWORD=CambiaEstaContrasenaPorUnaMuySegura123!
POSTGRES_DB=breinerdiaz_db

# Puerto de enlace local (LOOPBACK ONLY: 127.0.0.1)
# 5432 o 5433 suelen estar ocupados en local; puedes usar 5434 o el que prefieras
DB_LOCAL_PORT=5434

# Versión de PostgreSQL
POSTGRES_VERSION=16-alpine
